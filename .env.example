# All inference stays on this machine. Initial model downloads require internet.
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
OLLAMA_MODEL=qwen2.5:7b
ENABLE_DIARIZATION=false
HF_TOKEN=
MAX_UPLOAD_MB=200
MAX_AUDIO_SECONDS=7200
JOB_TIMEOUT_SECONDS=7200
LLM_TIMEOUT_SECONDS=180
RETAIN_AUDIO=false
# Optional path to a locally installed, licensed Unicode TrueType font:
PDF_FONT_PATH=
