# ==========================
# Окружение и зависимости
# ==========================
# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# Node / Frontend
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
.npm/

# ==========================
# Данные и Модели (ВАЖНО!)
# ==========================
